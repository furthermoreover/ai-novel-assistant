# ============================================================
# AI 小说创作助手 - 环境配置模板
# 复制本文件为 .env 并填入你的密钥（.env 已被 .gitignore 排除）
# ============================================================

# ---- 数据库连接（本机 PostgreSQL，端口按实际修改）----
DATABASE_URL=postgresql://postgres:你的数据库密码@localhost:29934/novel_assistant

# ---- 智谱 Key（知识库向量化用，必填）----
# 获取：https://open.bigmodel.cn/api-keys
ZHIPU_API_KEY=你的智谱key

# ---- 千问（写作/摘要模型，可选，不填则回退智谱）----
# 获取：https://bailian.console.aliyun.com 创建 DashScope API Key
CHAT_API_KEY=
CHAT_API_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# 千问写作模型（token-plan 端点）：qwen3.8-max(最强) / qwen3.7-plus / qwen3.8-flash(省钱)
# 该端点还支持：glm-5.2 / deepseek-v4-pro / deepseek-v4-flash-0731
WRITING_MODEL=qwen3.8-flash
SUMMARIZE_MODEL=qwen3.8-flash

# 如果想用智谱做写作（不填上面的 CHAT_API_KEY 即可）：
#   CHAT_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
#   WRITING_MODEL=glm-4-flash   （或 glm-4-air / glm-4-plus / glm-4.5）

# ---- 服务器 ----
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
